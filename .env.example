# MCCoE Cyber Dashboard configuration
# Contact: support@mccoe.org

# Set to true for fully offline/portable operation (no external API calls)
LOCAL_ONLY=true

# Dashboard starts empty; set true only to auto-load demo data on startup
AUTO_LOAD_DEMO=false

# Live threat intelligence feeds (requires LOCAL_ONLY=false)
ENABLE_LIVE_FEEDS=false
ENABLE_URLHAUS=true
ENABLE_OTX=true
ENABLE_THREATFOX=true
ENABLE_OPENPHISH=false
ENABLE_NVD_FEED=true
ENABLE_CISA_KEV=true
FEED_STALE_FALLBACK=true

# Optional background feed refresh (Streamlit daemon thread, every 24h by default)
ENABLE_AUTO_FEED_REFRESH=false
AUTO_FEED_REFRESH_HOURS=24

OTX_API_KEY=

# Free abuse.ch Auth-Key for ThreatFox (https://auth.abuse.ch/)
ABUSECH_AUTH_KEY=

# Optional NIST NVD API key — improves rate limits (50 req/30s vs 5 without)
# Request yours: https://nvd.nist.gov/developers/request-an-api-key
# Example placeholder only — replace with your own key in .env (never commit .env)
NVD_API_KEY=bd830bdc-1d95-4c3b-8029-73f3ce575ade
INSTRUCTOR_MODE=false
ALLOWED_TARGETS=127.0.0.1,localhost
# Optional: full path to nmap.exe if not on PATH (auto-detects Program Files (x86)\Nmap on Windows)
NMAP_PATH=
FEED_CACHE_TTL_MINUTES=15
MAX_UPLOAD_MB=50
# Threat Feeds UI pagination (all IOCs browsable page by page)
IOC_UI_PAGE_SIZE=50
# PDF/Markdown reports: include newest N IOCs (no UI cap; default 5000)
MAX_IOCS_REPORT=5000
MAX_IOCS_DISPLAY=50000
IOC_RECENT_DAYS=30
AUTO_REPORT_ON_UPLOAD=true

# FastAPI backend
API_BASE_URL=http://127.0.0.1:8000
USE_API_BACKEND=false
API_AUTH_ENABLED=true
API_KEY=mccoe-training-key
API_BASIC_USER=mccoe
API_BASIC_PASSWORD=training